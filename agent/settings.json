{
  "theme": "dark",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna"
  ],
  "compaction": {
    "enabled": false,
    "reserveTokens": 32768
  },
  "httpIdleTimeoutMs": 60000,
  "markdown": {
    "mermaid": "streaming"
  },
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "packages": [
    "./early-extensions/mcp-project-trust.ts",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@woksin/pi-jobs@0.3.1",
    "npm:@woksin/pi-recover@0.1.1",
    "npm:pi-browser-use",
    "npm:donsetch",
    "npm:@woksin/pi-context-budget@0.3.0",
    "npm:@woksin/pi-orch@0.1.0",
    "./local-packages/pi-questions"
  ],
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "anthropic/claude-opus-5-5": "medium",
    "openai-codex/gpt-6-astra": "high",
    "openai-codex/gpt-6-luna": "low",
    "anthropic/claude-sonnet-5-5": "medium",
    "openai-codex/gpt-6.1-sol": "high"
  },
  "collapseChangelog": true,
  "cacheWarming": "off",
  "showCacheMissNotices": true,
  "extensions": [
    "-builtin:mcp"
  ]
}
