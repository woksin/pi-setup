{
  "theme": "dark",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-2",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "openai-codex/gpt-6.2-sol",
    "openai-codex/gpt-6.2-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-terra"
  ],
  "compaction": {
    "enabled": false,
    "reserveTokens": 32768
  },
  "httpIdleTimeoutMs": 60000,
  "markdown": {
    "mermaid": "streaming"
  },
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "packages": [
    "./early-extensions/mcp-project-trust.ts",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@woksin/pi-jobs",
    "npm:@woksin/pi-recover",
    "npm:pi-browser-use",
    "npm:donsetch",
    "npm:@woksin/pi-context-budget",
    "npm:@woksin/pi-orch",
    "./local-packages/pi-questions"
  ],
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "anthropic/claude-opus-5-5": "medium",
    "anthropic/claude-fable-5-2": "medium",
    "openai-codex/gpt-6.2-astra": "high",
    "openai-codex/gpt-6-luna": "low",
    "anthropic/claude-sonnet-5-5": "medium",
    "openai-codex/gpt-6.2-sol": "high",
    "openai-codex/gpt-6.1-terra": "medium"
  },
  "collapseChangelog": true,
  "cacheWarming": "off",
  "showCacheMissNotices": true,
  "extensions": [
    "-builtin:mcp",
    "-extensions/code-change-notice.ts",
    "-extensions/model-drift.ts"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@gotgenes/pi-anthropic-auth\",\"scope\":\"user\"}": "3.6.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@tintinweb/pi-subagents\",\"scope\":\"user\"}": "0.26.2",
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"./local-packages/pi-jobs\",\"scope\":\"user\"}": "0.6.0",
    "{\"source\":\"./local-packages/pi-recover\",\"scope\":\"user\"}": "0.1.1",
    "{\"source\":\"./local-packages/pi-questions\",\"scope\":\"user\"}": "0.2.1",
    "{\"source\":\"npm:pi-mcp-adapter@2.32.1\",\"scope\":\"project\"}": "2.32.1",
    "{\"source\":\"./local-packages/pi-orch\",\"scope\":\"user\"}": "0.3.1"
  }
}
