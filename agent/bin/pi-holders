#!/usr/bin/env python3
"""pi-holders — which processes hold a path (cwd or open file), hard-link aware. Read-only.

Usage: pi-holders [--json] [--verbose] [--timeout SECONDS] PATH [PATH ...]

One lsof snapshot of every process (this process and its children excluded). A process holds PATH when its
cwd is PATH or below it, or when it has an open name below PATH that is not ambiguous. An open name that is a
regular file with more than one hard link is ambiguous: lsof may report another link's name, and unlinking this
name never affects a holder of the inode. Ambiguous names are counted separately and do not hold. Names open
only outside PATH are never reported. A name below PATH that cannot be stat'ed counts as holding.

  --json             machine-readable output on stdout
  --verbose          also list the ambiguous (shared-inode) names
  --timeout SECONDS  limit for each lsof call (default 60)

Examples:
  pi-holders ~/repos/Stage/.worktrees/old-wt
  pi-holders --verbose --json /Volumes/work/repo/Source/App/bin

Output: one line per holding process and path: `PID COMMAND cwd|open NAME`.

Exit codes:
  0  no path is held
  1  at least one path is held
  2  usage error
  3  inspection failed, timed out or was incomplete: do not treat the path as free

See also: pi-cleanup (uses the same rule for worktree and build-output removal), pi-retain, `lsof -p PID`.
"""
import argparse
import json
import os
import runpy
import sys
from pathlib import Path

HOLDERS = runpy.run_path(str(Path(__file__).resolve().with_name("holders.py")))
USAGE = "Usage: pi-holders [--json] [--verbose] [--timeout SECONDS] PATH [PATH ...]"


class UsageParser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError(message)


def positive_seconds(value):
    try:
        seconds = float(value)
    except ValueError:
        seconds = 0.0
    if not 0 < seconds < float("inf"):
        raise ValueError(f"invalid --timeout: {value!r}")
    return seconds


def parse(argv):
    """-> (paths, json, verbose, timeout), or None after printing help; raises ValueError on bad usage.
    A bare `help` is a path, not a request for help."""
    if any(arg in ("-h", "--help") for arg in argv[: argv.index("--") if "--" in argv else len(argv)]):
        print(__doc__.strip())
        return None
    parser = UsageParser(add_help=False, allow_abbrev=False)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--timeout", type=positive_seconds, default=60.0)
    parser.add_argument("paths", nargs="*")
    args = parser.parse_args(argv)
    if not args.paths:
        raise ValueError("no PATH given")
    return args.paths, args.json, args.verbose, args.timeout


def canonical(path):
    return os.path.realpath(os.path.expanduser(path))


def build_report(processes, paths, verbose):
    report = []
    for path in paths:
        base = canonical(path)
        held, ambiguous = HOLDERS["holders_of"](processes, base, forgive_shared=True)
        entry = {"path": path, "resolved": base, "held": bool(held), "holders": held, "ambiguous": len(ambiguous)}
        if verbose:
            entry["ambiguous_names"] = ambiguous
        report.append(entry)
    return report


def print_text(report, verbose):
    for entry in report:
        for holder in entry["holders"]:
            print(f"{holder['pid']} {holder['command']} {holder['kind']} {holder['name']}")
        note = f" ({entry['ambiguous']} shared-inode names ignored)" if entry["ambiguous"] else ""
        print(f"pi-holders: {entry['path']}: {'held' if entry['held'] else 'not held'}{note}", file=sys.stderr)
        for item in entry.get("ambiguous_names", []) if verbose else []:
            print(f"ambiguous {item['pid']} {item['command']} {item['name']}")


def main(argv):
    try:
        parsed = parse(argv)
    except ValueError as error:
        print(f"pi-holders: {error}\n{USAGE}", file=sys.stderr)
        return 2
    if parsed is None:
        return 0
    paths, as_json, verbose, timeout = parsed
    try:
        processes = HOLDERS["snapshot"](timeout)
    except HOLDERS["SnapshotError"] as error:
        if as_json:
            print(json.dumps({"status": "error", "error": str(error)}))
        print(f"pi-holders: inspection failed: {error}", file=sys.stderr)
        return 3
    report = build_report(processes, paths, verbose)
    any_held = any(entry["held"] for entry in report)
    if as_json:
        print(json.dumps({"status": "held" if any_held else "clear", "paths": report}))
    else:
        print_text(report, verbose)
    return 1 if any_held else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
