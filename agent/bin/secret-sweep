#!/usr/bin/env python3
"""Daily, read-only gitleaks sweep; reports contain metadata, never matched values."""
import argparse
from collections import defaultdict
from datetime import date
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time


class SweepError(Exception):
    pass


PRUNED_DIRS = {"node_modules", "bin", "obj", ".venv", "venv", "dist", ".cache", "Pods",
               ".gradle", "target", ".next", ".git", "__pycache__", "Caches", ".npm", ".nuget"}


def targets(roots, sessions, max_depth, deadline, status=None, max_directories=100000):
    """Discover bounded records; retain results when access or traversal is limited."""
    status = status if status is not None else {"unreadable": 0, "limits": set()}
    found = {sessions.resolve()} if sessions.is_dir() else set()
    visited = set()
    home = Path.home().resolve()

    def unreadable(_):
        status["unreadable"] += 1

    for root in roots:
        root = root.expanduser().resolve()
        if not root.is_dir():
            continue
        for directory, dirs, _ in os.walk(root, onerror=unreadable):
            if time.monotonic() >= deadline or len(visited) >= max_directories:
                status["limits"].add("discovery time/directory cap")
                return sorted(found)
            path = Path(directory)
            if path in visited:
                dirs[:] = []
                continue
            visited.add(path)
            if path.name == ".ai-work":
                found.add(path)
                dirs[:] = []
                continue
            dirs[:] = sorted((name for name in dirs if name not in PRUNED_DIRS
                              and (path / name) not in {home / "Library", home / ".Trash"}
                              and not (path / name).is_symlink()),
                             key=lambda name: (name != ".ai-work", name))
            if len(path.relative_to(root).parts) >= max_depth:
                if dirs:
                    status["limits"].add("discovery depth cap")
                dirs[:] = []
    return sorted(found)


def metadata(rows):
    """Discard Secret/Match fields before using scanner data in a report."""
    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
        raise SweepError("gitleaks returned an invalid report")
    # Defend even against a scanner that ignores --redact. Never retain raw fields.
    forbidden = [value for row in rows for key, value in row.items()
                 if key.lower() in {"secret", "match"} and isinstance(value, str) and value]
    cleaned = [{key: value for key, value in row.items() if key.lower() not in {"secret", "match"}}
               for row in rows]

    def safe(value):
        text = str(value)
        for value in forbidden:
            text = text.replace(value, "[REDACTED]")
        return text.replace("\n", " ").replace("\r", " ").replace("|", "\\|").replace("`", "'")

    result = []
    for row in cleaned:
        line = row.get("StartLine")
        result.append((safe(row.get("File", "unknown")), safe(row.get("RuleID", "unknown")),
                       line if type(line) is int and line > 0 else None))
    return result


def scan(tool, target, report, deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise SweepError("sweep exceeded its time limit")
    try:
        completed = subprocess.run(
            [tool, "dir", str(target), "--no-banner", "--redact", "--report-format", "json",
             "--max-target-megabytes", "20", "--report-path", str(report)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=remaining, check=False,
        )
    except subprocess.TimeoutExpired:
        raise SweepError("gitleaks exceeded the sweep time limit") from None
    except OSError:
        raise SweepError("gitleaks could not be started") from None
    if completed.returncode not in (0, 1):
        raise SweepError("gitleaks failed; scanner output suppressed to protect secrets")
    try:
        rows = json.loads(report.read_text())
    except (OSError, ValueError):
        raise SweepError("gitleaks did not produce a valid JSON report") from None
    return metadata(rows)


def write_report(directory, findings, error, discovery=None):
    grouped = defaultdict(list)
    for file, rule, line in findings:
        grouped[(file, rule)].append(line)
    lines = [f"# Secret sweep — {date.today().isoformat()}", "",
             "Read-only scan; matched values are never included. Rotate exposed credentials.", ""]
    partial = discovery and (discovery["unreadable"] or discovery["limits"])
    if partial:
        reasons = ", ".join(sorted(discovery["limits"])) or "unreadable directories"
        lines += [f"Partial discovery: {reasons}; unreadable directories skipped: {discovery['unreadable']}.", ""]
    if error:
        lines += [f"Incomplete: {error}.", ""]
    if grouped:
        lines += ["| File | Rule | Count | Lines |", "| --- | --- | ---: | --- |"]
        for (file, rule), numbers in sorted(grouped.items()):
            locations = ", ".join(str(n) for n in sorted({n for n in numbers if n is not None}))
            lines.append(f"| {file} | {rule} | {len(numbers)} | {locations or 'unknown'} |")
    elif not error:
        lines.append("No findings in scanned records." if partial else "No findings.")
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination = directory / f"{date.today().isoformat()}.md"
    # Do not follow a pre-existing report symlink or expose a partially written report.
    with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as output:
        temporary = Path(output.name)
        try:
            output.write("\n".join(lines) + "\n")
            output.close()
            os.replace(temporary, destination)
        finally:
            temporary.unlink(missing_ok=True)


def positive(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, action="append", help="discovery root (repeatable)")
    parser.add_argument("--max-depth", type=positive, default=8)
    parser.add_argument("--max-directories", type=positive, default=100000)
    parser.add_argument("--timeout", type=positive, default=120, help="total discovery/scanner seconds")
    args = parser.parse_args()
    home = Path.home()
    findings, error = [], None
    discovery = {"unreadable": 0, "limits": set()}
    try:
        tool = shutil.which("gitleaks")
        if not tool:
            raise SweepError("gitleaks is missing from PATH; install it before running secret-sweep")
        deadline = time.monotonic() + args.timeout
        records = targets(args.root or [home, Path("/Volumes/sourcecode/repos")],
                          home / ".pi/agent/sessions", args.max_depth,
                          time.monotonic() + min(30, args.timeout / 2), discovery, args.max_directories)
        with tempfile.TemporaryDirectory(prefix="secret-sweep-") as temporary:
            for index, target in enumerate(records):
                findings.extend(scan(tool, target, Path(temporary) / f"{index}.json", deadline))
    except SweepError as exc:
        error = str(exc)
    try:
        write_report(home / ".pi/agent/logs/secret-sweep", findings, error, discovery)
    except OSError:
        print("secret-sweep: could not write the redacted report", file=sys.stderr)
        return 2
    if error:
        print(f"secret-sweep: {error}", file=sys.stderr)
        return 2
    print(f"secret-sweep: {len(findings)} finding(s); see ~/.pi/agent/logs/secret-sweep/{date.today().isoformat()}.md")
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())
