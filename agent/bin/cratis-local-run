#!/usr/bin/env bash
# Copyright (c) Cratis. All rights reserved.
# Licensed under the MIT license. See LICENSE file in the project root for full license information.
# Usage: cratis-local-run [--priority low|normal|high] <kind> <label> -- <cmd...>
# Priority defaults to $CRATIS_LOCAL_RUN_PRIORITY, else normal. High priority still needs pi-phase's grant.
set -euo pipefail
case "${1:-}" in -h|--help)
    cat <<'HELP'
Usage: cratis-local-run [--priority low|normal|high] <kind> <label> -- <cmd...>
Run a build or test command through pi-phase (bounded, queued, one at a time).

Options:
  --priority P   low|normal|high (default: $CRATIS_LOCAL_RUN_PRIORITY, else normal).
                 High priority still needs pi-phase's grant.
Environment:
  CRATIS_LOCAL_RUN_PRIORITY       default priority
  CRATIS_LOCAL_RUN_TIMEOUT        run timeout in seconds (default 900)
  CRATIS_LOCAL_RUN_QUEUE_TIMEOUT  queue wait in seconds (default 3600)
Examples:
  cratis-local-run test unit -- dotnet test      # runs the command through pi-phase
  cratis-local-run --priority low build web -- npm run build
Exit codes:
  0 help shown, or the command's own exit code via pi-phase
  2 usage error or invalid priority
See also: docs/reference.md, pi-phase --help
HELP
    exit 0 ;;
esac
usage() { printf 'Usage: cratis-local-run [--priority low|normal|high] <kind> <label> -- <cmd...>\n' >&2; exit 2; }
priority=${CRATIS_LOCAL_RUN_PRIORITY:-normal}
if [ "${1:-}" = --priority ]; then
    [ "$#" -ge 2 ] || usage
    priority=$2
    shift 2
elif [ "${1#--priority=}" != "${1:-}" ]; then
    priority=${1#--priority=}
    shift
fi
case "$priority" in low|normal|high) ;; *) printf 'cratis-local-run: invalid priority %s (low|normal|high)\n' "$priority" >&2; exit 2 ;; esac
if [ "$#" -lt 4 ] || [ "$3" != -- ]; then
    usage
fi
kind=$1 label=$2
shift 3
exec "$HOME/.pi/agent/bin/pi-phase" run --kind "$kind" --label "$label" --priority "$priority" \
    --timeout "${CRATIS_LOCAL_RUN_TIMEOUT:-900}" --approved-long-timeout \
    --queue-timeout "${CRATIS_LOCAL_RUN_QUEUE_TIMEOUT:-3600}" -- "$@"
