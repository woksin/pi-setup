#!/bin/bash
# docker-guardian — keeps local Docker Desktop usable for agents without a human.
# Runs every 2 minutes from launchd (com.example.docker-guardian).
#  - Health: engine /info over the Docker socket (curl, 20 s deadline) plus `docker ps`. 3 consecutive failures (~6 min) => restart
#    Docker Desktop (quit, kill lingering backend, open), announce to lanes, verify.
#    Budget: at most 1 restart per 20 min and 3 per 2 h; beyond that it alerts instead.
#  - Not running at all => start it.
#  - Hygiene every 15 min while healthy: remove exited/dead containers finished >20 min ago,
#    prune unused networks older than 30 min, unused anonymous volumes, build cache above 8 GB.
#    Images: only superseded semver tags (keep newest 2) / dangling >24h; pinned/in-use/recent/floating stay.
# Authorised (2026-10-20): "the agents need to be able to do what it needs to do".
set -u
# DOCKER_GUARDIAN_TEST_PATH/_STATE/_LOG exist only for the dry-run harness (docker-guardian/test/run-scenarios.sh).
export PATH=${DOCKER_GUARDIAN_TEST_PATH:+$DOCKER_GUARDIAN_TEST_PATH:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
S=${DOCKER_GUARDIAN_STATE:-$HOME/.pi/agent/docker-guardian}; mkdir -p "$S"
LOG=${DOCKER_GUARDIAN_LOG:-$HOME/.pi/agent/logs/docker-guardian.log}; mkdir -p "$(dirname "$LOG")"
MSG=${DOCKER_GUARDIAN_MESSAGES:-}
now=$(date +%s); ts=$(date '+%Y-%m-%d %H:%M:%S')
log(){ echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }
announce(){ # $1 file-suffix, $2 text
  [ -n "$MSG" ] && [ -d "$MSG" ] && printf '%s\n' "$2" > "$MSG/ALL-docker-guardian-$(date +%H%M)-$1.md"
  osascript -e "display notification \"$2\" with title \"docker-guardian\"" >/dev/null 2>&1 || true
}
# run with deadline: dl SECONDS cmd...
# Wall-clock deadline (an iteration counter stretched to minutes under load average 120+).
dl(){ local t=$1; shift; "$@" & local p=$!; local end=$((SECONDS+t))
  while kill -0 $p 2>/dev/null; do [ $SECONDS -ge $end ] && { kill $p 2>/dev/null; sleep 1; kill -9 $p 2>/dev/null; return 124; }; sleep 0.2; done
  wait $p; }
# `docker info` alone is not enough: on 2026-10-20 17:30 info answered while `docker ps`/`images` hung
# for >10 min (containerd/engine wedged), so health also requires a container listing.
# INFO_OK records whether the engine API answered, so the load deferral can tell a slow listing from an outage.
# Engine API probe straight on the socket (2026-10-22 20:53): `docker info` (the CLI) first runs every CLI plugin's
# metadata command; under load it hung 20 s+ and never reached the engine while Testcontainers was served through the
# same socket, so three false "unhealthy" checks restarted a working Docker. curl /info has no plugin scan.
DOCKER_SOCK=${DOCKER_SOCK:-$HOME/.docker/run/docker.sock}; [ -S "$DOCKER_SOCK" ] || DOCKER_SOCK=/var/run/docker.sock
healthy(){ INFO_OK=0; dl 20 curl -sf --max-time 20 --unix-socket "$DOCKER_SOCK" -o /dev/null http://localhost/info || return 1; INFO_OK=1; dl 25 docker ps -q >/dev/null 2>&1; }
load1(){ sysctl -n vm.loadavg | awk '{print int($2)}'; }
# Diagnostic snapshot on every unhealthy check (2026-10-22): what used the CPU, the Docker VM's share, memory and
# running pi-phase phases, so hangs can be attributed afterwards. Read-only, bounded; never affects the decision.
snapshot(){ local f="${LOG%/*}/docker-guardian-snapshots.log"
  { echo "=== $(date '+%Y-%m-%d %H:%M:%S') $1 info_ok=${INFO_OK:-?} load=$(sysctl -n vm.loadavg)"
    dl 5 ps -Ao pid=,ni=,pcpu=,rss=,comm= -r | head -12
    dl 5 ps -Ao pcpu=,rss=,comm= | awk '/Virtualization|com.docker/ {c+=$1; m+=$2} END {printf "docker-vm+backend cpu=%.0f%% rss=%.1fGB\n", c, m/1048576}'
    dl 5 memory_pressure -Q 2>/dev/null | tail -1; sysctl -n vm.swapusage
    dl 5 "$HOME/.pi/agent/bin/pi-phase" status 2>&1 | grep -E ' running$' | cut -c1-160
  } >> "$f" 2>&1; }

# Narrow image cleanup: no force/prune, fail closed on missing inventory or phase state.
prune_superseded_images(){ python3 - "$S/pinned.txt" "$HOME/.pi/agent/bin/pi-phase" <<'PY'
import datetime as dt
import fnmatch
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

end = time.monotonic() + 45

def run(cmd):
    remaining = end - time.monotonic()
    if remaining <= 0:
        return None
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=min(10, remaining))
        return p.stdout + p.stderr if p.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None

def phases_safe():
    text = run([sys.argv[2], 'status'])
    if text is None:
        return False
    active = re.findall(r'^pi-phase: (\S+) .*elapsed=\d+s (?:running|orphan-group)$', text, re.M)
    return (all(kind in ('build', 'test', 'ci') for kind in active)
            and (bool(active) or 'pi-phase: no active phases' in text.splitlines()))

def decode(output):
    try:
        return json.loads(output)
    except (TypeError, ValueError):
        return None

def valid_id(value):
    return isinstance(value, str) and bool(re.fullmatch(r'(?:sha256:)?[a-f0-9]{64}', value))

def used_images():
    output = run(['docker', 'ps', '-aq', '--no-trunc'])
    if output is None:
        return None
    ids = output.splitlines()
    if len(ids) > 500 or any(not re.fullmatch(r'[a-f0-9]{12,64}', cid) for cid in ids):
        return None
    if not ids:
        return set()
    output = run(['docker', 'inspect', '--format', '{{.Image}}', *ids])
    if output is None:
        return None
    images = output.splitlines()
    return set(images) if len(images) == len(ids) and all(valid_id(i) for i in images) else None

def version(tag):
    # A suffix is a workload variant, except for explicitly known prerelease markers.
    match = re.fullmatch(r'v?(\d+(?:\.\d+)*)([^0-9.].*)?', tag)
    if not match:
        return None
    numbers = tuple(int(part) for part in match[1].split('.'))
    suffix = match[2] or ''
    pre = re.match(r'^-(alpha|beta|preview|rc)(?:[.-]?(\d+))?(?=$|[-+])', suffix)
    marker, serial = (0, 0)
    if pre:
        marker = ('alpha', 'beta', 'preview', 'rc').index(pre[1])
        serial = int(pre[2] or 0)
        suffix = suffix[pre.end():]
    # Compare only equal precision inside each repository + variant group.
    return suffix, len(numbers), (numbers, not bool(pre), marker, serial)


def age(created):
    try:
        return (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(created.replace('Z', '+00:00'))).total_seconds()
    except (ValueError, TypeError, AttributeError):
        return 0

def floating(tag):
    return tag == 'latest' or tag.endswith('-development') or tag.startswith('local-')

def main():
    if Path(sys.argv[1]).with_name('no-image-prune').is_file():
        print('images: skipped (no-image-prune switch)')
        return
    if not phases_safe():
        print('images: skipped (integration running or phase state unknown)')
        return
    context = run(['docker', 'context', 'show'])
    if (context is None or context.strip() not in ('default', 'desktop-linux')
            or (os.environ.get('DOCKER_HOST') and not os.environ['DOCKER_HOST'].startswith('unix://'))):
        print('images: skipped (not a verified local context)')
        return
    host = decode(run(['docker', 'context', 'inspect', context.strip(), '--format', '{{json .Endpoints.docker.Host}}']))
    if not isinstance(host, str) or not host.startswith('unix://'):
        print('images: skipped (not a local Unix endpoint)')
        return
    try:
        pins = [line.strip() for line in Path(sys.argv[1]).read_text().splitlines()
                if line.strip() and not line.lstrip().startswith('#')]
    except OSError:
        print('images: skipped (pin list unreadable)')
        return
    output = run(['docker', 'image', 'ls', '-q', '--no-trunc'])
    dangling = run(['docker', 'image', 'ls', '-q', '--no-trunc', '--filter', 'dangling=true'])
    if output is None or dangling is None:
        print('images: skipped (image inventory unavailable)')
        return
    dangling_ids = set(dangling.splitlines())
    ids = list(dict.fromkeys(output.splitlines() + dangling.splitlines()))
    if len(ids) > 300 or any(not valid_id(i) for i in ids):
        print('images: skipped (inventory invalid or exceeds 300-image budget)')
        return
    if not ids:
        print('images: checked 0')
        return
    images = decode(run(['docker', 'image', 'inspect', *ids]))
    used = used_images()
    if (used is None or not isinstance(images, list) or len(images) != len(ids)
            or any(not isinstance(i, dict) or not valid_id(i.get('Id')) for i in images)):
        print('images: skipped (image/container inventory unknown)')
        return
    repositories = {}
    for image in images:
        tags = image.get('RepoTags') or []
        digests = image.get('RepoDigests') or []
        if (not isinstance(tags, list) or not isinstance(digests, list)
                or any(not isinstance(ref, str) for ref in [*tags, *digests])):
            print('images: skipped (malformed tag inventory)')
            return
        for ref in tags:
            if not isinstance(ref, str):
                return
            repo, _, tag = ref.rpartition(':')
            value = version(tag)
            if repo and value is not None and not floating(tag):
                suffix, precision, rank = value
                repositories.setdefault((repo, suffix, precision), {})[ref] = rank
    keep = {ref for tags in repositories.values()
            for ref in sorted(tags, key=lambda ref: (tags[ref], ref), reverse=True)[:2]}
    def short_alias(repo, parsed):
        suffix, precision, _ = parsed
        return precision < 3 and any(r == repo and variant == suffix and width > precision
                                     for r, variant, width in repositories)

    candidates = []
    for image in images:
        iid, tags = image['Id'], image.get('RepoTags') or []
        hours = age(image.get('Created')) / 3600
        if (iid in used or hours < 6
                or any(fnmatch.fnmatchcase(ref, pin) for ref in [iid, *tags, *(image.get('RepoDigests') or [])] for pin in pins)):
            continue
        actual_tags = [ref for ref in tags if ref != '<none>:<none>']
        if not actual_tags:
            if hours > 24 and iid in dangling_ids:
                candidates.append((iid, iid))
            continue
        # A floating alias protects its whole image, not just that alias.
        if any(floating(ref.rpartition(':')[2])
               or (version(ref.rpartition(':')[2]) is not None
                   and short_alias(ref.rpartition(':')[0], version(ref.rpartition(':')[2])))
               for ref in actual_tags):
            continue
        for ref in actual_tags:
            repo, _, tag = ref.rpartition(':')
            value = version(tag)
            if value is not None:
                suffix, precision, rank = value
                peers = repositories.get((repo, suffix, precision), {})
                if ref not in keep and any(v > rank for v in peers.values()):
                    candidates.append((ref, iid))
    for ref, iid in candidates:
        if not phases_safe():
            print('images: stopped (integration/unknown phase state)')
            break
        current_used = used_images()
        if current_used is None:
            print('images: stopped (container inventory unknown)')
            break
        if iid in current_used:
            continue
        current = decode(run(['docker', 'image', 'inspect', ref]))
        if not isinstance(current, list) or len(current) != 1 or current[0].get('Id') != iid:
            continue  # Tag changed since the snapshot.
        if run(['docker', 'rmi', ref]) is not None:
            print('images: removed ' + ref + ' (' + iid + ')')
        else:
            print('images: kept ' + ref + ' (rmi refused/unknown)')

main()
PY
}

# single instance (a restart can take ~4 min, longer than the launchd interval)
if ! mkdir "$S/lock.d" 2>/dev/null; then
  op=$(cat "$S/lock.d/pid" 2>/dev/null); if [ -n "$op" ] && kill -0 "$op" 2>/dev/null; then exit 0; fi
  rm -rf "$S/lock.d"; mkdir "$S/lock.d" 2>/dev/null || exit 0
fi
echo $$ > "$S/lock.d/pid"; trap 'rm -rf "$S/lock.d"' EXIT
# Shared .NET build servers (VBCSCompiler, MSBuild nodes) to nice 10 whoever started them, so phase_nice
# also covers compiles and the Docker VM keeps CPU (L0, 2026-10-22). Never raises priority, never kills.
r=$(dl 10 "$HOME/.pi/agent/bin/renice-builders" 2>/dev/null); [ -n "$r" ] && log "$r"

if ! pgrep -qf '/Applications/Docker.app/Contents/MacOS/Docker' && ! pgrep -qf 'com.docker.backend'; then
  [ -f "$S/paused" ] && exit 0      # `touch ~/.pi/agent/docker-guardian/paused` to stop auto-start/restarts
  log "docker not running -> starting"; open -a Docker; echo "$now" > "$S/last-start"; exit 0
fi

if healthy; then
  echo 0 > "$S/fails"
  # Planned restart (e.g. to apply new VM CPU/memory settings): only when no container is running.
  # A timed-out listing must not count as "no containers" (2026-10-20: a hung `docker ps` triggered this).
  if [ -f "$S/pending-restart" ] && running=$(dl 15 docker ps -q 2>/dev/null) && [ -z "$running" ]; then
    rm -f "$S/pending-restart"; echo 3 > "$S/fails"; log "planned restart (no running containers)"
    PLANNED=1
  fi
fi
if [ "${PLANNED:-0}" != 1 ] && healthy; then
  # Snapshot image references before either doctor or guardian removes exited containers.
  last=$(cat "$S/last-gc" 2>/dev/null || echo 0)
  if [ $((now-last)) -ge 900 ]; then
    image_actions=$(dl 55 prune_superseded_images 2>&1)
    image_exit=$?
    while IFS= read -r action; do [ -z "$action" ] || log "$action"; done <<< "$image_actions"
    [ "$image_exit" -eq 0 ] || log "images: failed/timeout exit=$image_exit (guardian continues)"
  fi
  # Independent timestamp: a missing/failed doctor never blocks guardian health/GC.
  doctor="$(dirname "$0")/dev-doctor"
  last_doctor=$(cat "$S/last-doctor" 2>/dev/null || echo 0)
  case "$last_doctor" in ''|*[!0-9]*) last_doctor=0 ;; esac
  doctor_now=$(date +%s)
  if [ -x "$doctor" ] && [ $((doctor_now-last_doctor)) -ge 900 ]; then
    echo "$doctor_now" > "$S/last-doctor"
    actions=$(dl 55 "$doctor" --apply --only browsers,owned-containers,docker-stale --quiet 2>&1)
    doctor_exit=$?
    while IFS= read -r action; do [ -z "$action" ] || log "dev-doctor: $action"; done <<< "$actions"
    [ "$doctor_exit" -eq 0 ] || log "dev-doctor: failed/timeout exit=$doctor_exit (guardian continues)"
  fi
  if [ $((now-last)) -ge 900 ]; then
    echo "$now" > "$S/last-gc"; n=0
    for id in $(dl 30 docker ps -aq --filter status=exited --filter status=dead 2>/dev/null); do
      f=$(dl 10 docker inspect -f '{{.State.FinishedAt}}' "$id" 2>/dev/null) || continue
      t=$(date -j -u -f '%Y-%m-%dT%H:%M:%S' "${f%%.*}" +%s 2>/dev/null) || continue
      [ $((now-t)) -gt 1200 ] && dl 20 docker rm "$id" >/dev/null 2>&1 && n=$((n+1))
    done
    nets_before=$(dl 15 docker network ls -q 2>/dev/null | wc -l | tr -d ' ')
    dl 60 docker network prune -f --filter until=30m >/dev/null 2>&1
    dl 120 docker volume prune -f >/dev/null 2>&1
    dl 300 docker builder prune -f --keep-storage 8GB >/dev/null 2>&1
    nets=$(dl 15 docker network ls -q 2>/dev/null | wc -l | tr -d ' ')
    log "gc: removed $n containers; networks $nets_before -> $nets"
  fi
  exit 0
fi

[ -f "$S/paused" ] && { log "unhealthy but paused"; exit 0; }
if [ "${PLANNED:-0}" = 1 ]; then fails=3; else
fails=$(( $(cat "$S/fails" 2>/dev/null || echo 0) + 1 )); echo $fails > "$S/fails"
log "unhealthy x$fails"; snapshot "unhealthy x$fails"; fi
[ $fails -lt 3 ] && exit 0
# Load deferral (L0, 2026-10-20 22:05): at 21:58 a restart at host load ~90 killed a running integration
# phase although the engine API still answered. When `docker info` answers, `docker ps` does not and load1 > 48,
# defer the restart up to 10 min, re-checking every 60 s; restart when load drops and it still fails, when the
# engine API stops answering, or when the deferral runs out. Old behaviour: touch "$S/load-defer-off".
DEFER_LOAD=${DOCKER_GUARDIAN_DEFER_LOAD:-48}; DEFER_STEPS=${DOCKER_GUARDIAN_DEFER_STEPS:-10}
if [ "${PLANNED:-0}" != 1 ] && [ ! -f "$S/load-defer-off" ] && [ "${INFO_OK:-0}" = 1 ] && [ "$(load1)" -gt "$DEFER_LOAD" ]; then
  log "unhealthy x$fails under load $(load1) with docker info answering: deferring restart up to $DEFER_STEPS min"
  announce defer "docker-guardian ($(date +%H:%M)): docker ps is not answering while host load is $(load1); restart deferred up to $DEFER_STEPS min. Shed host load (builds/specs) if you can; Docker phases may be slow."
  reason="still unhealthy after the $DEFER_STEPS min load deferral"
  for i in $(seq 1 "$DEFER_STEPS"); do
    sleep 60
    if healthy; then echo 0 > "$S/fails"; log "recovered during load deferral after ${i} min (load $(load1))"; exit 0; fi
    l=$(load1)
    [ "$INFO_OK" = 1 ] || { reason="docker info stopped answering during the deferral"; break; }
    [ "$l" -gt "$DEFER_LOAD" ] || { reason="load dropped to $l and docker is still unhealthy"; break; }
  done
  log "$reason: restarting"
fi
# restart budget
touch "$S/restarts"
recent=$(awk -v n=$now '$1>n-7200' "$S/restarts" | wc -l | tr -d ' ')
lastr=$(tail -1 "$S/restarts" 2>/dev/null || echo 0); lastr=${lastr:-0}
if [ $((now-lastr)) -lt 1200 ] || [ "$recent" -ge 3 ]; then
  if [ ! -f "$S/alerted" ] || [ $((now-$(cat "$S/alerted"))) -gt 3600 ]; then
    echo $now > "$S/alerted"; log "restart budget exhausted ($recent in 2h) -> alert"
    announce budget "docker-guardian: Docker unresponsive again but restart budget is used ($recent restarts in 2 h). L0: find the load source (pi-phase status, docker stats) before more Docker phases."
  fi
  exit 0
fi
echo $now >> "$S/restarts"; echo 0 > "$S/fails"
log "restarting Docker Desktop"
why="was unresponsive for ~6 min"; [ "${PLANNED:-0}" = 1 ] && why="is idle and has a planned settings change (more VM memory)"
announce restart "docker-guardian ($(date +%H:%M)): Docker Desktop $why and is being restarted automatically. Docker phases running now will fail; rerun them once ALL-docker-guardian-*-ok appears. Non-Docker work is unaffected."
dl 60 osascript -e 'quit app "Docker"' >/dev/null 2>&1
for i in $(seq 1 30); do pgrep -qf 'com.docker.backend' || break; sleep 2; done
pkill -f 'com.docker.backend' 2>/dev/null; pkill -f '/Applications/Docker.app/Contents/MacOS/Docker' 2>/dev/null; sleep 3
pkill -9 -f 'com.docker.backend' 2>/dev/null; pkill -9 -f 'com.docker.virtualization' 2>/dev/null; pkill -9 -f 'com.docker.krun' 2>/dev/null; sleep 2
open -a Docker
for i in $(seq 1 36); do sleep 5; healthy && { log "docker up after $((i*5))s"; announce ok "docker-guardian ($(date +%H:%M)): Docker is back (up after $((i*5)) s). Docker phases may resume."; exit 0; }; done
log "docker not healthy 180s after restart"; announce failed "docker-guardian: Docker did not come back within 3 min of a restart. Will retry within budget; L0 please check."
exit 0
