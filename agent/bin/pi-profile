#!/usr/bin/env python3
"""pi-profile — switch pi agent model/effort profiles.

Profiles live in ~/.pi/agent/profiles/<name>/:
  agents/*.md          agent definitions (copied over ~/.pi/agent/agents/)
  workflows/*.js       workflow overrides (copied over ~/.pi/agent/workflows/)
  routing.md           "## Model routing" section spliced into ~/.pi/agent/AGENTS.md

Usage:
  pi-profile                 show the active profile and whether live files match it
  pi-profile list            list profiles
  pi-profile use <name>      activate a profile (refuses if live files were edited; --force overrides)
  pi-profile save            copy the live files back into the active profile
  pi-profile routing         splice only the active profile's routing.md into the AGENTS.md routing block

Also accepts -h, --help or help.

Changes take effect for new sessions (and new subagents; restart pi to be sure).

Examples:
  pi-profile                 # read-only status
  pi-profile list            # read-only
  pi-profile use <name>      # state-changing: replaces live agent files
Exit codes:
  0 success (or help)
  1 unknown command or bad arguments, or an error message (e.g. no active profile)
See also: docs/reference.md, README.md
"""
import filecmp
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path

ROOT = Path.home() / ".pi" / "agent"
PROFILES = ROOT / "profiles"
ACTIVE = PROFILES / "ACTIVE"
AGENTS_MD = ROOT / "AGENTS.md"
START = "<!-- pi-profile:routing:start"
END = "<!-- pi-profile:routing:end -->"


def profiles():
    return sorted(p.name for p in PROFILES.iterdir() if p.is_dir())


def active():
    return ACTIVE.read_text().strip() if ACTIVE.exists() else None


def split_agents_md():
    text = AGENTS_MD.read_text()
    s = text.find(START)
    e = text.find(END)
    if s < 0 or e < 0 or e < s:
        sys.exit(f"routing markers not found in {AGENTS_MD}")
    s_body = text.index("\n", s) + 1
    return text[:s_body], text[s_body:e], text[e:]


def managed_files(name):
    """(profile file, live file) pairs for a profile."""
    base = PROFILES / name
    pairs = []
    # Only real agent/workflow files: backups (*.bak-*) and stray files are never copied live.
    for sub, ext in (("agents", ".md"), ("workflows", ".js")):
        d = base / sub
        if d.is_dir():
            for f in sorted(d.iterdir()):
                if f.is_file() and f.suffix == ext:
                    pairs.append((f, ROOT / sub / f.name))
    return pairs


def drift(name):
    """Live files that differ from the given profile."""
    out = []
    for src, dst in managed_files(name):
        if not dst.exists() or not filecmp.cmp(src, dst, shallow=False):
            out.append(str(dst.relative_to(ROOT)))
    routing = PROFILES / name / "routing.md"
    if routing.exists() and split_agents_md()[1] != routing.read_text():
        out.append("AGENTS.md (routing section)")
    return out


def cmd_status():
    name = active()
    print(f"active profile: {name or '(none)'}")
    if name:
        d = drift(name)
        print("live files match profile" if not d else "live files differ from profile:\n  " + "\n  ".join(d))
    print("available: " + ", ".join(profiles()))


def cmd_use(name, force):
    if name not in profiles():
        sys.exit(f"unknown profile '{name}'. available: {', '.join(profiles())}")
    cur = active()
    if cur and cur != name and not force:
        d = drift(cur)
        if d:
            sys.exit(
                f"live files were edited since '{cur}' was applied:\n  " + "\n  ".join(d)
                + f"\nrun 'pi-profile save' to keep them in '{cur}', or 'pi-profile use {name} --force' to discard"
            )
    for src, dst in managed_files(name):
        shutil.copy2(src, dst)
    routing = PROFILES / name / "routing.md"
    if routing.exists():
        head, _, tail = split_agents_md()
        AGENTS_MD.write_text(head + routing.read_text() + tail)
    ACTIVE.write_text(name + "\n")
    print(f"activated '{name}'. Start a new pi session (or /reload) for it to take effect.")


def cmd_save():
    name = active()
    if not name:
        sys.exit("no active profile")
    for src, dst in managed_files(name):
        if dst.exists():
            shutil.copy2(dst, src)
    routing = PROFILES / name / "routing.md"
    if routing.exists():
        routing.write_text(split_agents_md()[1])
    print(f"saved live files into '{name}'")


def cmd_routing():
    """Replace only the bytes between the routing markers with the active profile's routing.md."""
    name = active()
    if not name or Path(name).name != name or name in (".", ".."):
        sys.exit("no valid active profile")
    source = PROFILES / name / "routing.md"
    if not source.is_file():
        sys.exit(f"active profile '{name}' has no routing.md")
    body = source.read_bytes()
    try:
        body.decode("utf-8")
    except UnicodeDecodeError:
        sys.exit(f"{source} is not valid UTF-8")
    start, end = START.encode(), END.encode()
    if start in body or end in body:
        sys.exit(f"{source} contains routing markers")
    target = AGENTS_MD.resolve()
    data = target.read_bytes()
    starts = list(re.finditer(rb"(?m)^<!-- pi-profile:routing:start(?: \((?:(?!-->)[^\r\n])*\))? -->\r?\n", data))
    ends = list(re.finditer(rb"(?m)^<!-- pi-profile:routing:end -->(?:\r?\n|\Z)", data))
    if data.count(b"pi-profile:routing:") != 2 or len(starts) != 1 or len(ends) != 1:
        sys.exit(f"expected exactly one routing marker pair in {target}")
    s_body, e = starts[0].end(), ends[0].start()
    if e < s_body:
        sys.exit(f"routing markers are misordered in {target}")
    head, old, tail = data[:s_body], data[s_body:e], data[e:]
    if old == body:
        print(f"routing already matches '{name}'")
        return
    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.name}.routing-", dir=target.parent)
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(head + body + tail)
            stream.flush()
            os.fsync(stream.fileno())
        shutil.copymode(target, tmp)
        os.replace(tmp, target)
    finally:
        tmp.unlink(missing_ok=True)
    print(f"routing section updated from '{name}'")


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    if not argv:
        return cmd_status()
    if argv[0] == "list":
        cur = active()
        for p in profiles():
            print(("* " if p == cur else "  ") + p)
    elif argv[0] == "use" and len(argv) >= 2:
        cmd_use(argv[1], "--force" in argv[2:])
    elif argv[0] == "save":
        cmd_save()
    elif argv[0] == "routing" and len(argv) == 1:
        cmd_routing()
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
