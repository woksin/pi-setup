#!/usr/bin/env bash
# Usage: inbox-watch [--alias NAME]... LANE [GROUP]
# Use with one job_watch: until=success, interval=120. Exit 0: filenames printed;
# 1: no inbound changes; 2: usage/I/O error.
# Names: SENDER-to-RCPT[-RCPT...]-topic.md or RCPT-from-SENDER-topic.md, optionally
# prefixed with a numeric timestamp (20261023-074001-L0-to-L15-x.md).
# Recipient/sender ids are the run of tokens starting with a capital
# (L15, L18b, R-AI, R-Studio); the topic starts at the first lowercase or digit token.
# Inbound: a recipient is LANE, an alias, ALL or GROUP (or the name starts
# with GROUP-/ALL-); messages the lane or an alias sent are skipped.
# Aliases: --alias NAME (repeatable) or INBOX_ALIASES=R-AI,R-Studio.
# INBOX_DIR overrides user.json's orchMessagesDir, then ~/.pi/agent/inbox.
# Marker advances to scan START only after output, so concurrent edits stay new.
# Its JSON content baselines initial files; unchanged initial files stay silent.
set -eu
case "${1:-}" in -h|--help)
    cat <<'HELP'
Usage: inbox-watch [--alias NAME]... LANE [GROUP]
Print the names of inbound message files (*.md) that are new since the last check.

Options:
  --alias NAME   also treat NAME as this lane (repeatable)
Environment:
  INBOX_ALIASES  comma-separated aliases (same as --alias)
  INBOX_DIR      inbox directory (default: ~/.pi/agent/inbox)
Examples:
  inbox-watch L15              # first run creates the marker and exits 1
  inbox-watch --alias R-AI L15 team   # changes the marker after printing names
Exit codes:
  0 filenames printed
  1 no inbound changes
  2 usage or I/O error
See also: docs/reference.md, lane-status --help
HELP
    exit 0 ;;
esac
aliases=()
while (( $# > 0 )) && [[ $1 == --alias ]]; do
    (( $# >= 2 )) || { printf 'Usage: inbox-watch [--alias NAME]... LANE [GROUP]\n' >&2; exit 2; }
    aliases+=("$2")
    shift 2
done
if [[ -n ${INBOX_ALIASES:-} ]]; then
    IFS=',' read -r -a env_aliases <<< "$INBOX_ALIASES"
    for a in "${env_aliases[@]}"; do [[ -n $a ]] && aliases+=("$a"); done
fi
if (( $# < 1 || $# > 2 )); then
    printf 'Usage: inbox-watch [--alias NAME]... LANE [GROUP]\n' >&2
    exit 2
fi
lane=$1
group=${2:-}
for name in "$lane" ${group:+"$group"} ${aliases[@]+"${aliases[@]}"}; do
    if [[ ! $name =~ ^[A-Za-z0-9_]+(-[A-Za-z0-9_]+)*$ ]]; then
        printf 'inbox-watch: invalid lane/group/alias: %s\n' "$name" >&2
        exit 2
    fi
done
if [[ ${INBOX_DIR+x} ]]; then
    dir=$INBOX_DIR
else
    dir=$(python3 - <<'PY'
import json
from pathlib import Path

try:
    data = json.loads((Path.home() / ".pi/agent/user.json").read_text())
    value = data.get("orchMessagesDir") if isinstance(data, dict) else None
except (OSError, ValueError):
    value = None
print(str(Path(value).expanduser()) if isinstance(value, str) and value.strip() else Path.home() / ".pi/agent/inbox")
PY
    )
fi
if ! cd "$dir" 2>/dev/null; then
    printf 'inbox-watch: invalid INBOX_DIR: %s\n' "$dir" >&2
    exit 2
fi
mark="${lane}-inbox.marker"
start=$(mktemp "${TMPDIR:-/tmp}/inbox-${lane}.XXXXXX") || { printf 'inbox-watch: cannot create temp file\n' >&2; exit 2; }
listing="${start}.list"
trap 'rm -f -- "$start" "$listing"' EXIT
# The marker is the scan start moved back 2 s. Its timestamp has coarser
# granularity than writes, so a file written in the same second as the
# previous scan was missed. A file in that overlap may be reported twice (harmless).
set_mark() {
    initial_files set
}
# Keep only the initial snapshot, not a growing history. Timestamp overlap still
# handles later writes/renames; exact stat fingerprints exempt unchanged initial
# files from that overlap. Empty markers from earlier versions remain supported.
initial_files() {
    python3 - "$1" "$mark" "$start" "$listing" <<'PY'
import json
import os
import stat
import sys
import time
import uuid
from pathlib import Path

mode, marker, start, listing = sys.argv[1:]


def fingerprint(path):
    stat = path.stat()
    return [stat.st_dev, stat.st_ino, stat.st_ctime_ns, stat.st_mtime_ns, stat.st_size]


def quarantine_marker():
    try:
        info = os.lstat(marker)
    except FileNotFoundError:
        return False
    if stat.S_ISREG(info.st_mode):
        return False
    destination = f"{marker}.invalid.{time.time_ns()}.{uuid.uuid4().hex}"
    try:
        os.rename(marker, destination)
    except FileNotFoundError:
        return True
    print(f"inbox-watch: warning: invalid marker moved to {destination}", file=sys.stderr)
    return True


def open_marker():
    fd = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    source = os.fdopen(fd, "rb")
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        source.close()
        raise OSError("marker must be a regular file")
    return source


def read_baseline(source):
    limit = 2 * 1024 * 1024
    try:
        if os.fstat(source.fileno()).st_size > limit:
            return {}
        data = source.read(limit + 1)
        if len(data) > limit:
            return {}
        baseline = json.loads(data or b"{}")
        if not isinstance(baseline, dict):
            return {}
        for name, stamp in baseline.items():
            if not isinstance(name, str) or not name.endswith(".md") or "/" in name:
                return {}
            if not isinstance(stamp, list) or len(stamp) != 5:
                return {}
            if any(type(value) is not int or value < 0 for value in stamp):
                return {}
        return baseline
    except (OSError, ValueError, RecursionError):
        return {}


def load_marker():
    if quarantine_marker():
        return {}, 0, True
    try:
        with open_marker() as source:
            marker_time = os.fstat(source.fileno()).st_mtime_ns
            return read_baseline(source), marker_time, False
    except FileNotFoundError:
        return {}, 0, True
    except OSError:
        if quarantine_marker():
            return {}, 0, True
        raise


def write_marker(baseline):
    temporary = f"{marker}.tmp.{uuid.uuid4().hex}"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o666)
    try:
        with os.fdopen(fd, "w") as target:
            json.dump(baseline, target)
            target.flush()
            cutoff = (Path(start).stat().st_mtime_ns // 1_000_000_000 - 2) * 1_000_000_000
            os.utime(target.fileno(), ns=(cutoff, cutoff))
        quarantine_marker()
        os.replace(temporary, marker)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def initial_baseline():
    cutoff = Path(start).stat().st_mtime_ns
    baseline = {}
    for path in Path(".").glob("*.md"):
        try:
            stamp = fingerprint(path)
        except FileNotFoundError:
            continue
        # A write during first-arm scanning must remain eligible on the next poll.
        if path.is_file() and stamp[2] <= cutoff:
            baseline[path.name] = stamp
    return baseline


if mode == "record":
    write_marker(initial_baseline())
elif mode == "set":
    baseline, _, recovered = load_marker()
    write_marker(initial_baseline() if recovered else baseline)
else:
    baseline, marker_time, recovered = load_marker()
    candidates = []
    for name in Path(listing).read_text().splitlines():
        try:
            stamp = fingerprint(Path(name))
        except FileNotFoundError:
            continue
        if stamp[2] > marker_time and baseline.get(Path(name).name) != stamp:
            candidates.append(name)
    Path(listing).write_text("".join(name + "\n" for name in candidates))
    if recovered:
        write_marker(initial_baseline())
PY
}
if [[ ! -e $mark && ! -L $mark ]]; then
    initial_files record && set_mark || { printf 'inbox-watch: cannot create marker\n' >&2; exit 2; }
    exit 1
fi
args=(. -maxdepth 1 -type f -name '*.md')
# The filter compares file ctime with the marker mtime obtained from a no-follow descriptor.
find "${args[@]}" -print > "$listing" || { printf 'inbox-watch: scan failed\n' >&2; exit 2; }
initial_files filter || { printf 'inbox-watch: scan failed\n' >&2; exit 2; }
me=("$lane" ${aliases[@]+"${aliases[@]}"})
# has LIST ID: LIST is "-a-b-c-"; ID may itself contain dashes (R-AI).
has() { [[ $1 == *"-$2-"* ]]; }
is_id() {
    local tok=$1 id
    for id in "${me[@]}" ALL ${group:+"$group"}; do [[ $tok == "$id" ]] && return 0; done
    [[ $tok =~ ^[A-Z] || $tok =~ ^ttys[0-9]+$ ]]
}
# Prints "kind|senders|recipients" with dash-wrapped lists, kind = to|from|none.
parse() {
    local base=${1%.md} i=0 k=-1 kind=none left='' right=''
    local -a t
    IFS='-' read -r -a t <<< "$base"
    for (( i = 1; i < ${#t[@]}; i++ )); do
        if [[ ${t[i]} == to || ${t[i]} == from ]]; then k=$i; kind=${t[i]}; break; fi
    done
    if (( k < 0 )); then
        printf 'none||-%s-\n' "$base"
        return
    fi
    for (( i = 0; i < k; i++ )); do left+="-${t[i]}"; done
    for (( i = k + 1; i < ${#t[@]}; i++ )); do
        # "cc" (SENDER-to-A-cc-B-topic) continues the recipient list.
        [[ ${t[i]} == cc ]] && continue
        is_id "${t[i]}" || break
        right+="-${t[i]}"
    done
    if [[ $kind == to ]]; then
        printf 'to|%s-|%s-\n' "$left" "$right"
    else
        printf 'from|%s-|%s-\n' "$right" "$left"
    fi
}
inbound() {
    local name=$1 parsed senders rcpts id
    parsed=$(parse "$name")
    parsed=${parsed#*|}
    senders=${parsed%%|*}; rcpts=${parsed#*|}
    for id in "${me[@]}"; do has "$senders" "$id" && return 1; done
    [[ $name == ALL-* ]] && return 0
    [[ -n $group && $name == "$group"-* ]] && return 0
    for id in "${me[@]}" ALL ${group:+"$group"}; do has "$rcpts" "$id" && return 0; done
    return 1
}
found=0
while IFS= read -r path; do
    name=${path#./}
    [[ $name == *-inbox.marker ]] && continue
    inbound "$name" || continue
    printf '%s\n' "$name"
    found=1
done < "$listing"
if (( found )); then
    set_mark || { printf 'inbox-watch: cannot update marker\n' >&2; exit 2; }
    exit 0
fi
exit 1
