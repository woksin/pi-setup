# ignored paths that are safe to lose with a worktree (from audit_wt.py)
BUILD_IGNORED_RE = re.compile(
    r"(^|/)(bin|obj|node_modules|dist|build|out|target|TestResults|coverage|\.vite|\.turbo|\.next|\.nuxt|"
    r"\.cache|\.parcel-cache|\.pytest_cache|__pycache__|\.gradle|\.kotlin|\.idea|\.vs|\.DS_Store|"
    r"\.eslintcache|artifacts|\.yarn/cache|\.yarn/install-state\.gz|playwright-report|test-results|"
    r"storybook-static|\.docusaurus|\.astro|_site|\.jekyll-cache|\.sass-cache|\.venv|venv|\.tox|"
    r"\.mypy_cache|\.ruff_cache|\.angular)(/|$)|\.tsbuildinfo$|\.log$|\.pyc$|"
    r"(^|/)\.ai-work/(cache|output)(/|$)"
)
# audit_wt.py's SENSITIVE minus its `.ai-work/keep/` alternative: .ai-work is archived
# before removal, so keep/ content is preserved rather than a blocker. Anything else in
# .ai-work that looks sensitive (.env, keys, ...) still blocks.
SENSITIVE_RE = re.compile(
    r"(^|/)\.env|appsettings\.[^/]*\.json$|\.(pem|key|pfx|p12|db|sqlite|sqlite3|mdf)$|"
    r"(^|/)secrets?|credentials"
)
