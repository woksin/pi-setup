DEFAULT_ROOTS = ["{{REPOS_ROOT}}"]
STEPS_ALL = ["build", "worktrees", "docker", "caches", "bins"]
BIN_SWEEP = runpy.run_path(str(Path(__file__).resolve().with_name("bin_sweep.py")))
LOG_DIR = os.path.expanduser("~/.pi/agent/logs")
LOG_FILE = os.path.join(LOG_DIR, "pi-cleanup.log")
LOCK_FILE = os.path.join(LOG_DIR, "pi-cleanup.lock")
LOG_MAX = 900_000  # bytes; truncate oldest lines above this (limit is 1 MB)
LOG_KEEP = 600_000
POOL = 8
SIZE_BUDGET_S = 30  # total wall-clock budget for worktree `du` measurements
DRY_WORKER = False
TMP_ROOTS = ("/tmp", "/private/tmp")
TMP_PREFIXES = ("pisync.", "gr-stage-ui")
TMP_MIN_AGE = 2 * 3600

BUILD_DIRS = {
    "bin", "obj", "node_modules", "dist", "TestResults", "coverage", "coverage-results",
    ".vite", ".turbo", ".next", ".nuxt", ".parcel-cache", "playwright-report", "test-results",
    "storybook-static", ".docusaurus", ".astro", ".angular", ".eslintcache", "__pycache__",
