{
  "enabled": true,
  "defaultLimitMinutes": 60,
  "maxFallbacksPerPrompt": 2,
  "maxContextTokensForFallback": 150000,
  "restoreWhenExpired": true,
  "limitPatterns": {
    "anthropic": [
      "rate_limit_error",
      "exceed your account's rate limit"
    ],
    "openai-codex": [
      "ChatGPT usage limit",
      "usage limit has been reached"
    ],
    "kimi-coding": [
      "usage limit",
      "quota"
    ]
  },
  "pairs": [
    [
      "anthropic/claude-opus-5-5",
      "openai-codex/gpt-6.1-sol"
    ],
    [
      "anthropic/claude-sonnet-5-5",
      "openai-codex/gpt-6.1-sol"
    ],
    [
      "anthropic/claude-haiku-5-5",
      "openai-codex/gpt-6-luna"
    ],
    [
      "kimi-coding/k3-256k",
      "openai-codex/gpt-6.1-sol"
    ]
  ],
  "unavailableMinutes": 10,
  "unavailablePatterns": {
    "kimi-coding": [
      "overloaded",
      "resource_not_found_error",
      "timed out",
      "timeout",
      "OAuth refresh failed",
      "^\\s*5\\d\\d\\b",
      "^\\s*401\\b",
      "unauthori[sz]ed",
      "authentication",
      "ECONNRESET|ECONNREFUSED|ETIMEDOUT|ENOTFOUND|fetch failed|socket hang up|network error"
    ]
  },
  "chains": {
    "kimi-coding/k3-256k": [
      "openai-codex/gpt-6.1-sol",
      "openai-codex/gpt-6-luna",
      "anthropic/claude-haiku-5-5"
    ]
  }
}
